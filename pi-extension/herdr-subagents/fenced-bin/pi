#!/bin/sh
set -eu

shim_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
clean_path=
old_ifs=$IFS
IFS=:
for directory in ${PATH:-}; do
  [ "$directory" = "$shim_dir" ] && continue
  clean_path="${clean_path:+$clean_path:}$directory"
done
IFS=$old_ifs
PATH=$clean_path
export PATH

# Pi uses this marker to publish lifecycle and session state to Herdr.
export HERDR_AGENT=pi

# A Herdr server inside the same sandbox may already create confined panes.
if [ "${FENCE_SANDBOX:-}" = "1" ]; then
  exec pi "$@"
fi

if ! command -v fence >/dev/null 2>&1; then
  echo "pi-herdr-subagents: Fence is required to start this child Pi agent" >&2
  exit 127
fi

exec fence -- pi "$@"
